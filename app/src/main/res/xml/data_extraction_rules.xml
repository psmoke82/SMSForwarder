<?xml version="1.0" encoding="utf-8"?><!--
   Android 12(API 31) 이상 백업/기기 간 전송 대상 제외 규칙.
   sms_forwarder.db 에는 수신 문자 원문(rawBody), 전달 대상 번호(recipientNumber),
   결제 금액이 평문으로 저장되므로 클라우드 백업과 기기 간 전송 양쪽에서 모두 제외한다.
   앱 자체 백업/복원 기능(data/backup)이 별도로 존재하므로 기능상 손실은 없다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="sms_forwarder.db" />
        <exclude domain="database" path="sms_forwarder.db-wal" />
        <exclude domain="database" path="sms_forwarder.db-shm" />
        <exclude domain="database" path="sms_forwarder.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="sms_forwarder.db" />
        <exclude domain="database" path="sms_forwarder.db-wal" />
        <exclude domain="database" path="sms_forwarder.db-shm" />
        <exclude domain="database" path="sms_forwarder.db-journal" />
    </device-transfer>
</data-extraction-rules>
